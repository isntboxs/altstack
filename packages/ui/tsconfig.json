{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@altstack/config/tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react",
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"paths": {
			"@altstack/ui/*": ["./src/*"]
		}
	},
	"include": ["."],
	"exclude": ["node_modules", "dist"]
}
