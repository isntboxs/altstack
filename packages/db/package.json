{
	"name": "@altstack/db",
	"version": "0.0.0",
	"private": true,
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./relations": "./src/relations.ts",
		"./schemas": "./src/schemas.ts",
		"./schemas/auth": "./src/schemas/auth.ts",
		"./schemas/github": "./src/schemas/github.ts",
		"./schemas/project": "./src/schemas/project.ts",
		"./seed": "./src/seed.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./relations": "./dist/relations.mjs",
			"./schemas": "./dist/schemas.mjs",
			"./schemas/auth": "./dist/schemas/auth.mjs",
			"./schemas/github": "./dist/schemas/github.mjs",
			"./schemas/project": "./dist/schemas/project.mjs",
			"./seed": "./dist/seed.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "vp pack",
		"check": "vp check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "bun run ./src/seed.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "vp pack --watch",
		"test": "vp test"
	},
	"dependencies": {
		"@altstack/env": "workspace:*",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"octokit": "catalog:",
		"pg": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@altstack/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/pg": "catalog:",
		"bumpp": "catalog:",
		"drizzle-kit": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
