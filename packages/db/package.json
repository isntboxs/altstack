{
	"name": "@altstack/db",
	"version": "0.0.0",
	"private": true,
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./relations": "./src/relations.ts",
		"./schemas": "./src/schemas.ts",
		"./schemas/audit": "./src/schemas/audit.ts",
		"./schemas/auth": "./src/schemas/auth.ts",
		"./schemas/bookmark": "./src/schemas/bookmark.ts",
		"./schemas/category": "./src/schemas/category.ts",
		"./schemas/github": "./src/schemas/github.ts",
		"./schemas/ownership": "./src/schemas/ownership.ts",
		"./schemas/project": "./src/schemas/project.ts",
		"./schemas/report": "./src/schemas/report.ts",
		"./schemas/review-notification": "./src/schemas/review-notification.ts",
		"./schemas/tag": "./src/schemas/tag.ts",
		"./seed-file-cli": "./src/seed-file-cli.ts",
		"./seed-file-github": "./src/seed-file-github.ts",
		"./seed-file-import": "./src/seed-file-import.ts",
		"./seed-file-parser": "./src/seed-file-parser.ts",
		"./seed-file-validation": "./src/seed-file-validation.ts",
		"./seed-taxonomy": "./src/seed-taxonomy.ts",
		"./tags": "./src/tags.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./relations": "./dist/relations.mjs",
			"./schemas": "./dist/schemas.mjs",
			"./schemas/audit": "./dist/schemas/audit.mjs",
			"./schemas/auth": "./dist/schemas/auth.mjs",
			"./schemas/bookmark": "./dist/schemas/bookmark.mjs",
			"./schemas/category": "./dist/schemas/category.mjs",
			"./schemas/github": "./dist/schemas/github.mjs",
			"./schemas/ownership": "./dist/schemas/ownership.mjs",
			"./schemas/project": "./dist/schemas/project.mjs",
			"./schemas/report": "./dist/schemas/report.mjs",
			"./schemas/review-notification": "./dist/schemas/review-notification.mjs",
			"./schemas/tag": "./dist/schemas/tag.mjs",
			"./seed-file-cli": "./dist/seed-file-cli.mjs",
			"./seed-file-github": "./dist/seed-file-github.mjs",
			"./seed-file-import": "./dist/seed-file-import.mjs",
			"./seed-file-parser": "./dist/seed-file-parser.mjs",
			"./seed-file-validation": "./dist/seed-file-validation.mjs",
			"./seed-taxonomy": "./dist/seed-taxonomy.mjs",
			"./tags": "./dist/tags.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "vp pack",
		"check": "vp check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "bun run ./src/seed-file-cli.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "vp pack --watch",
		"test": "vp test",
		"test:isolated": "bun run ./tests/run-isolated.ts",
		"test:scoped": "bun run ./tests/run-scoped.ts"
	},
	"dependencies": {
		"@altstack/env": "workspace:*",
		"@altstack/shared": "workspace:*",
		"csv-parse": "^7.0.3",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"octokit": "catalog:",
		"pg": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@altstack/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/pg": "catalog:",
		"bumpp": "catalog:",
		"drizzle-kit": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
