NODE_ENV=development
PORT=3009
DATABASE_URL=postgresql://postgres:password@localhost:5432/altstack
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5433/altstack_test
APP_NAME=Altstack
BETTER_AUTH_URL=http://localhost:3009
BETTER_AUTH_SECRET=your-better-auth-secret
# Server runtime only. Leave empty for localhost/host-only cookies.
# For trusted sibling hosts, set their most specific shared parent domain (no scheme/port).
BETTER_AUTH_COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3010,http://<internal-ip>:3010,https://dokploy.example.com
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_TOKEN=your-github-token

# Server only. Use a sending API key and a sender on a Resend-verified domain.
# Never prefix these with VITE_. Both are needed to send Magic Links.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server only. Use a dedicated development Redis database locally.
UPSTASH_REDIS_REST_URL=https://your-development-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-development-redis-rest-token

VITE_APP_NAME=Altstack
VITE_APP_URL=http://localhost:3010
VITE_SERVER_URL=http://localhost:3009
VITE_S3_PUBLIC_URL=https://cdn.domain.com

S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_PUBLIC_URL=https://cdn.domain.com
