# Local defaults and non-working examples only. See docs/development.md#configuration.
# Fill required provider credentials in your private .env before starting the API.
NODE_ENV=development
PORT=3009
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/altstack
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5433/altstack_test
APP_NAME=AltStack
BETTER_AUTH_URL=http://localhost:3009
# Generate privately: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Server runtime only. Leave empty for localhost/host-only cookies.
# For trusted sibling hosts, set their most specific shared parent domain (no scheme/port).
BETTER_AUTH_COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3010
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional for local requests; required by the scheduled GitHub refresh worker.
GITHUB_TOKEN=

# Server only. Use a sending API key and a sender on a Resend-verified domain.
# Never prefix these with VITE_. Shared by Magic Links and review decisions.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Server only. Trusted Web origin (no path/query), also listed in CORS_ORIGINS.
# Required for the scheduled review email worker; HTTPS in production.
EMAIL_APP_URL=http://localhost:3010

# Server only. Use a dedicated development Redis database locally.
UPSTASH_REDIS_REST_URL=https://redis.example.com
UPSTASH_REDIS_REST_TOKEN=

VITE_APP_NAME=AltStack
VITE_APP_URL=http://localhost:3010
VITE_SERVER_URL=http://localhost:3009
VITE_S3_PUBLIC_URL=https://cdn.example.com

S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=example-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://cdn.example.com
