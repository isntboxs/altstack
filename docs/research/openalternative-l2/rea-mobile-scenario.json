{
	"browser": {
		"mode": "launch",
		"executable_path": "/usr/lib/chromium/chromium"
	},
	"start_url": {
		"url": "https://openalternative.co/supabase"
	},
	"environment": {
		"viewport": {
			"width": 390,
			"height": 844,
			"device_scale_factor": 1
		},
		"timezone": "Asia/Jakarta",
		"color_scheme": "light"
	},
	"actions": [
		{
			"step_id": "wait-more",
			"action": "wait_for",
			"locator": {
				"kind": "role",
				"role": "button",
				"name": "More"
			},
			"state": "visible",
			"timeout_ms": 10000
		},
		{
			"step_id": "open-more",
			"action": "click",
			"locator": {
				"kind": "role",
				"role": "button",
				"name": "More"
			},
			"timeout_ms": 5000
		},
		{
			"step_id": "wait-report",
			"action": "wait_for",
			"locator": {
				"kind": "role",
				"role": "menuitem",
				"name": "Report"
			},
			"state": "visible",
			"timeout_ms": 5000
		}
	],
	"capture": {
		"after_each_step": ["url"],
		"at_end": ["url", "accessibility"],
		"events": ["page-errors"]
	}
}
