{
	"name": "server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"module": "dist/index.js",
	"scripts": {
		"build": "tsdown",
		"check": "vp check",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"format": "vp fmt",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix"
	},
	"dependencies": {
		"@cort/env": "workspace:*",
		"@elysia/node": "^1.4.6",
		"elysia": "catalog:"
	},
	"devDependencies": {
		"@cort/config": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.22.3",
		"tsx": "^4.23.0",
		"typescript": "catalog:"
	}
}
