{
	"name": "web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vp dev",
		"generate-routes": "tsr generate",
		"generate:og": "bun run scripts/generate-og.ts",
		"preview": "vp preview",
		"test": "vp test run",
		"test:auth-http": "vp run --filter @altstack/db test:scoped -- bun run apps/web/tests/auth-http.acceptance.ts",
		"test:browser": "vp test run --project browser",
		"test:browser:watch": "vp test watch --project browser --browser.headless=false",
		"test:categories-http": "vp run --filter @altstack/db test:isolated -- bun run apps/web/tests/category-http.acceptance.ts",
		"test:seo-http": "vp run --filter @altstack/db test:scoped -- bun run apps/web/tests/seo-http.acceptance.ts",
		"test:unit": "vp test run --project unit"
	},
