{
	"lsp": {
		"typescript-ls": {
			"binary": {
				"path": "node_modules/.bin/tsrs",
				"arguments": ["--lsp", "-stdio"]
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"fixKind": "safe_fix",
					"typeAware": true,
					"unusedDisableDirectives": "deny"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": "./vite.config.ts",
					"run": "onSave"
				}
			}
		}
	},
	"languages": {
		"CSS": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"GraphQL": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"Handlebars": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
