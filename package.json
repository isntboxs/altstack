		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"bumpp": "^12.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"jsdom": "^28.1.0",
		"lucide-react": "^1.25.0",
		"nitro": "^3.0.260610-beta",
		"react": "^19.2.8",
		"react-aria-components": "^1.19.0",
		"react-dom": "^19.2.8",
