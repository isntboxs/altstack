{
	"name": "altstack",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*",
		"tools/*"
	],
	"type": "module",
	"scripts": {
		"dev:web": "vp run @altstack/web#dev",
		"prepare": "vp config"
	},
	"dependencies": {},
	"devDependencies": {
		"@altstack/config": "workspace:*",
		"@tanstack/eslint-plugin-query": "^5.101.3",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@types/bun": "catalog:",
