{
	"name": "altstack",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*",
		"tools/*"
	],
	"type": "module",
	"scripts": {
		"db:down": "docker compose down postgres",
		"db:generate": "vp run --filter @altstack/db db:generate",
		"db:migrate": "vp run --filter @altstack/db db:migrate",
		"db:push": "vp run --filter @altstack/db db:push",
		"db:start": "docker compose up -d postgres",
		"db:stop": "docker compose stop postgres",
		"db:studio": "vp run --filter @altstack/db db:studio",
		"db:watch": "docker compose up postgres",
		"dev:web": "vp run @altstack/web#dev",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@altstack/config": "workspace:*",
		"@tanstack/eslint-plugin-query": "^5.101.3",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@types/bun": "catalog:",
		"eslint-plugin-react-hooks": "^7.1.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"overrides": {
		"vite": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"catalog": {
		"@fontsource-variable/inter": "^5.3.0",
		"@orpc/client": "^1.14.8",
		"@orpc/contract": "^1.14.8",
		"@orpc/json-schema": "^1.14.8",
		"@orpc/openapi": "^1.14.8",
		"@orpc/server": "^1.14.8",
		"@orpc/tanstack-query": "^1.14.8",
		"@orpc/zod": "^1.14.8",
		"@tabler/icons-react": "^3.45.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "^0.8.1",
		"@tanstack/router-cli": "^1.167.21",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.20.1",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"bumpp": "^12.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^1.0.0-rc.4",
		"drizzle-orm": "^1.0.0-rc.4",
		"evlog": "^2.22.3",
		"jsdom": "^28.1.0",
		"lucide-react": "^1.25.0",
		"nitro": "^3.0.260610-beta",
		"pg": "^8.22.0",
		"react": "^19.2.8",
		"react-aria-components": "^1.19.0",
		"react-dom": "^19.2.8",
		"shadcn": "^4.13.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
		"vite-plus": "0.2.5",
		"zod": "^4.4.3"
	}
}
