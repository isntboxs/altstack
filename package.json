{
	"name": "cort",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*",
		"tools/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"check": "vp check",
		"check-types": "vp run -r check-types",
		"dev": "vp run -r dev",
		"dev:server": "vp run --filter server dev",
		"hooks:setup": "vp config",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"ready": "vp check && vp run -r test && vp run -r build",
		"staged": "vp staged"
	},
	"devDependencies": {
		"@cort/config": "workspace:*",
		"@tanstack/eslint-plugin-query": "^5.101.2",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@types/node": "catalog:",
		"eslint-plugin-react-hooks": "^7.1.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"overrides": {
		"vite": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"catalog": {
		"@types/node": "^26.1.0",
		"elysia": "^1.4.29",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
		"vite-plus": "0.2.2"
	}
}
