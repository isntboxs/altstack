{
	"name": "altstack",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*",
		"tools/*"
	],
	"type": "module",
	"scripts": {
		"db:down": "docker compose down postgres",
		"db:generate": "vp run --filter @altstack/db db:generate",
		"db:migrate": "vp run --filter @altstack/db db:migrate",
		"db:push": "vp run --filter @altstack/db db:push",
		"db:seed": "vp run --filter @altstack/db db:seed",
		"db:start": "docker compose up -d postgres",
		"db:stop": "docker compose stop postgres",
		"db:studio": "vp run --filter @altstack/db db:studio",
		"db:watch": "docker compose up postgres",
		"dev:server": "vp run server#dev",
		"dev:web": "vp run web#dev",
		"prepare": "vp config",
		"ready": "vp check && vp run -r test && vp run -r build"
	},
	"devDependencies": {
		"@altstack/config": "workspace:*",
		"@tanstack/eslint-plugin-query": "^5.103.2",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@types/bun": "catalog:",
		"eslint-plugin-react-hooks": "^7.1.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"overrides": {
		"vite": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"catalog": {
		"@orpc/client": "^2.0.0-beta.31",
		"@orpc/contract": "^2.0.0-beta.31",
		"@orpc/evlog": "^2.0.0-beta.31",
		"@orpc/json-schema": "^2.0.0-beta.31",
		"@orpc/openapi": "^2.0.0-beta.31",
		"@orpc/server": "^2.0.0-beta.31",
		"@orpc/tanstack-query": "^2.0.0-beta.31",
		"@orpc/zod": "^2.0.0-beta.31",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tabler/icons-react": "^3.48.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form-start": "^1.33.5",
		"@tanstack/react-query": "^5.103.2",
		"@tanstack/react-query-devtools": "^5.103.2",
		"@tanstack/react-router": "^1.170.39",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.58",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/react-table-devtools": "^9.2.0",
		"@tanstack/router-cli": "^1.167.38",
		"@tanstack/router-plugin": "^1.168.40",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"better-auth": "^1.7.1",
		"bumpp": "^12.3.0",
		"cn": "^0.4.0",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^1.0.0-rc.5-ab785fc",
		"drizzle-orm": "^1.0.0-rc.5-ab785fc",
		"evlog": "^2.29.0",
		"hono": "^4.13.9",
		"jsdom": "^30.1.1",
		"limax": "^4.2.3",
		"lucide-react": "^1.25.0",
		"nitro": "^3.0.260903-beta",
		"octokit": "^5.0.5",
		"pg": "^8.23.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"reicon-react": "^1.2.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
		"vite-plus": "1.0.0-rc.0",
		"zod": "^4.6.5"
	}
}
