{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"better-auth": {
			"type": "remote",
			"url": "https://mcp.better-auth.com/mcp",
			"enabled": true
		},
		"orpc": {
			"type": "remote",
			"url": "https://orpc.dev/mcp",
			"enabled": true
		}
	},
	"lsp": {
		"oxlint": {
			"command": ["vp", "lint", "--lsp"],
			"extensions": [
				".ts",
				".tsx",
				".js",
				".jsx",
				".mjs",
				".cjs",
				".mts",
				".cts",
				".vue",
				".astro",
				".svelte"
			]
		},
		"oxfmt": {
			"command": ["vp", "fmt", "--lsp"],
			"extensions": [
				".ts",
				".tsx",
				".js",
				".jsx",
				".mjs",
				".cjs",
				".mts",
				".cts",
				".vue",
				".astro",
				".svelte",
				".json",
				".jsonc",
				".css",
				".html",
				".md",
				".yaml",
				".yml"
			]
		}
	},
	"formatter": {
		"oxfmt": {
			"command": ["vp", "fmt", "$FILE"],
			"extensions": [
				".js",
				".jsx",
				".mjs",
				".cjs",
				".ts",
				".tsx",
				".mts",
				".cts",
				".vue",
				".astro",
				".json",
				".jsonc",
				".css",
				".html",
				".md",
				".yaml",
				".yml"
			]
		}
	}
}
